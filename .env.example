# ===== LLM（OpenAI 兼容接口）=====
BASE_URL="https://your-llm-gateway/v1"
API_KEY="sk-xxxx"
MODEL="glm-5.3-flash"
# MODEL_FAST="glm-5.3-flash"   # 高频小任务（内心独白、内容审核），不填则使用 MODEL
# MODEL_SMART="glm-5.3"        # 低频重要任务（日报，以及之后的叙事导演、世界架构师），不填则使用 MODEL
# LLM_CONCURRENCY=4            # 并发请求数，遇到限流会自动退避
# LLM_DAILY_TOKENS=3000000     # 每日令牌预算（公网模式默认 300 万，0=不限），超出后小镇改用规则驱动、玩家交互暂停

# ===== 世界 =====
# STORY_RATING=cozy            # 内容分级：cozy（温馨）/ adventure（冒险，允许怪物入侵等冒险剧情）/ epic（仅本地）
# STORYTELLER=voyage           # 叙事者：voyage（远航，每季一个完整剧情弧，会自动开启《镜湖裂隙》）/ gentle（静水，以日常为主）/ chaos（掷骰）
# DATA_DIR=data                # 存档目录（save.json、ops.jsonl、snapshots/）

# ===== 服务 =====
# PORT=3000
# HOST=127.0.0.1               # 放在反向代理后面时建议只监听本机

# ===== 公网部署 =====
# PUBLIC_MODE=1                # 开启后：访客不能调速/暂停/重置/出号外，交互有频率限制并经过审核
# ADMIN_TOKEN=                 # 管理员令牌（mise run token 生成）；在页面「❔ 说明 → 🔐 管理员」里输入
# TRUST_PROXY=1                # 在 Caddy/Nginx 后面时开启，按 X-Forwarded-For 识别访客 IP
# ALLOW_INTERACTION=1          # 0 = 纯观赏模式，访客只能看
# IDLE_PAUSE_SEC=90            # 无人观看多少秒后小镇休眠（0 = 永不休眠）

# ===== 频率与审核 =====
# RATE_CHAT_PER_HOUR=30        # 每个 IP 每小时可以和居民说几句话（另有每分钟 4 句的突发限制）
# RATE_EVENT_PER_HOUR=3        # 每个 IP 每小时可发布几个事件
# EVENT_GLOBAL_COOLDOWN_SEC=120  # 全镇两次事件之间的最短间隔
# WEATHER_COOLDOWN_SEC=60      # 全镇两次改天气之间的最短间隔
# MODERATE_EVENTS=llm          # 事件审核：llm（关键词 + AI 审核）或 keyword（仅关键词）
# MODERATE_CHAT=keyword        # 聊天审核：同上（llm 会让每次聊天多一次调用）
# MAX_CLIENTS=200              # 同时在线页面上限
# MAX_CLIENTS_PER_IP=6

# ---- 自主进化（docs/design/autonomous-evolution.md）----
# EVOLVE=auto                   # off（默认）/ suggest / auto
# EVOLVE_BUDGET=200000          # 进化引擎每天的 token 上限，0 为不限
# EVOLVE_PUBLIC_DEPLOY=all      # 公网模式下 AI 裁决官可以自动上线的插件：off / data / all
# EVOLVE_SANDBOX_NET=isolated   # 已在系统层面给沙箱断网时设置
# EVOLVE_REVIEW_MODEL=          # 评审 Agent 用的模型（建议与 MODEL_SMART 不同）
