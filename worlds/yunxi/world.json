 "rules": [
  {
   "id": "ward_comfort",
   "name": "萤火安神",
   "when": {
    "every": 30
   },
   "forEach": "agent",
   "if": "e.status != 'sleeping' && nearStructure(e, 'light', 3)",
   "then": [
    {
     "op": "stat",
     "stat": "courage",
     "add": 2,
     "target": "e"
    },
    {
     "op": "stat",
     "stat": "stamina",
     "add": 1,
     "target": "e"
    }
   ]
  },
  {
   "id": "rain_tired",
   "name": "淋雨疲惫",
   "when": {
    "every": 60
   },
   "forEach": "agent",
   "if": "(weather == 'rain' || weather == 'storm') && !e.inside && e.status != 'sleeping'",
   "then": [
    {
     "op": "stat",
